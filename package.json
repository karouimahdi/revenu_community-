{
  "name": "communaute-le-revenu",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/web",
    "apps/cms"
  ],
  "scripts": {
    "dev": "concurrently -n web,cms -c blue,magenta \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/cms\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:cms": "npm run dev --workspace=apps/cms",
    "seed": "npm run seed --workspace=apps/cms",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:seed": "docker compose exec cms npm run seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
