# Copy to .env and fill in. Never commit the real .env — see CLAUDE.md.
#
# Secrets below (APP_KEYS, *_SALT, *_SECRET, ENCRYPTION_KEY) must each be a
# unique random value per environment. Generate one at a time with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS takes a comma-separated list of 2-4 such values.

# Server
HOST=0.0.0.0
PORT=1337

# Secrets — placeholders only, generate real values per the command above
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme

# Database (PostgreSQL — see README for local setup, e.g. the project's
# docker-compose Postgres service or any local instance)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=lerevenu
DATABASE_USERNAME=lerevenu
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
