# Copy to .env.local and fill in. Never commit the real file — see CLAUDE.md.

# Strapi REST API base URL. Server-only — never NEXT_PUBLIC_, per PLAN.md
# §4.3: the Strapi base URL and any session token must never reach the
# client bundle. Used by apps/web/lib/strapi/ and the Route Handlers in
# app/api/.
STRAPI_URL=http://127.0.0.1:1337
