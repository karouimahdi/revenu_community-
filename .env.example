# Optional overrides for `docker compose up` (npm run docker:up) — copy to
# `.env` at the repo root if you want different values. docker-compose.yml
# already has working dev-only defaults for all of these, so this file is
# not required to run the stack. Not used outside Docker Compose — apps/web
# and apps/cms keep their own .env.example for the non-Docker setup.

# Database
DATABASE_NAME=lerevenu
DATABASE_USERNAME=lerevenu
DATABASE_PASSWORD=lerevenu

# Strapi secrets — fine as the committed dev-only placeholders below for a
# throwaway local stack. Generate real values the same way as
# apps/cms/.env.example if you want this compose stack to feel closer to
# a real deployment:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=devKey1,devKey2,devKey3,devKey4
API_TOKEN_SALT=devApiTokenSalt
ADMIN_JWT_SECRET=devAdminJwtSecret
JWT_SECRET=devJwtSecret
TRANSFER_TOKEN_SALT=devTransferTokenSalt
ENCRYPTION_KEY=devEncryptionKey
